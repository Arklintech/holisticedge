# Holistic Edge Chiropractic & Wellness Clinic
# Environment Variables Configuration Example
#
# Note: Client-side environment variables in Vite must be prefixed with VITE_

# Public Site URL
VITE_SITE_URL=https://holisticedge.in

# Contact Numbers
VITE_CLINIC_PHONE=8142642051
VITE_WHATSAPP_NUMBER=918142642051

# Analytics & Monitoring (Optional)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Server-Side Meta WhatsApp Cloud API Webhook Configuration
# (Do NOT prefix with VITE_, server only)
WHATSAPP_VERIFY_TOKEN=holistic_edge_wa_webhook_verify_2025
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v19.0
