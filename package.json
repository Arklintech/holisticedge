{
  "name": "holistic-edge-chiropractic",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Holistic Edge Chiropractic & Wellness Support Clinic - Web Application & Admin Platform",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --port=3000 --host=0.0.0.0",
    "server": "node server/index.js",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "type-check": "node ./node_modules/typescript/bin/tsc --noEmit",
    "check:encoding": "node --test tests/checkEncoding.test.mjs",
    "test": "node --test tests/auditExports.test.mjs tests/checkEncoding.test.mjs tests/apiContracts.test.mjs tests/whatsappWebhook.test.mjs && node --experimental-strip-types --test tests/regression_HE_QA.test.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase": "^11.4.0",
    "googleapis": "^178.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^9.1.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  }
}
